# Copie para .env e ajuste os valores
SECRET_KEY=altere-esta-chave-em-producao
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Opcional: senha de acesso ao sistema (deixe vazio para uso local sem login)
APP_PASSWORD=

# Reset do banco: 1 = habilitado (apenas desenvolvimento), 0 = desabilitado
ENABLE_RESET=1

# Caminho do banco SQLite (opcional)
# DB_PATH=cacambas.db
